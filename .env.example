# Public Supabase project used by Spojex Admin and the Spojex super app.
# The publishable key is the anon key. It is safe to use on the server with
# row-level security. Do not put the service-role key in this app.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Optional aliases if you copy names from Spojex Admin. Prefer the server-only
# names above so the key is not shipped to the browser.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical origin for SEO, sitemap, and Open Graph. No trailing slash.
SITE_URL=http://localhost:3000

# Intentionally omitted from the marketing site:
# SUPABASE_SERVICE_ROLE_KEY, FIREBASE_*, CHAPA_*, notification keys.
